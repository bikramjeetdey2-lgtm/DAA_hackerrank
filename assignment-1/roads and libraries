import java.io.*;
import java.util.*;

public class Solution {

    static long roadsAndLibraries(int n, int c_lib, int c_road, List<List<Integer>> cities) {

        if (c_road >= c_lib) {
            return (long) n * c_lib;
        }

        List<List<Integer>> adj = new ArrayList<>();
        for (int i = 0; i <= n; i++) {
            adj.add(new ArrayList<>());
        }

        for (List<Integer> edge : cities) {
            int u = edge.get(0);
            int v = edge.get(1);
            adj.get(u).add(v);
            adj.get(v).add(u);
        }

        boolean[] visited = new boolean[n + 1];
        long cost = 0;

        for (int i = 1; i <= n; i++) {

            if (!visited[i]) {

                Stack<Integer> stack = new Stack<>();
                stack.push(i);
                visited[i] = true;

                long count = 0;

                while (!stack.isEmpty()) {
                    int node = stack.pop();
                    count++;

                    for (int neighbor : adj.get(node)) {
                        if (!visited[neighbor]) {
                            visited[neighbor] = true;
                            stack.push(neighbor);
                        }
                    }
                }

                cost += c_lib + (count - 1) * c_road;
            }
        }

        return cost;
    }

    public static void main(String[] args) throws IOException {

        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int q = Integer.parseInt(br.readLine().trim());

        while (q-- > 0) {

            String[] first = br.readLine().split(" ");

            int n = Integer.parseInt(first[0]);
            int m = Integer.parseInt(first[1]);
            int c_lib = Integer.parseInt(first[2]);
            int c_road = Integer.parseInt(first[3]);

            List<List<Integer>> cities = new ArrayList<>();

            for (int i = 0; i < m; i++) {
                String[] parts = br.readLine().split(" ");
                cities.add(Arrays.asList(
                        Integer.parseInt(parts[0]),
                        Integer.parseInt(parts[1])
                ));
            }

            System.out.println(roadsAndLibraries(n, c_lib, c_road, cities));
        }
    }
}
